#: classes/wc-paykka-credit-card-gateway.php:379
msgid "Unable to start a new PayKKa payment for this order."
msgstr "无法为该订单发起新的 PayKKa 支付。"

#: classes/wc-paykka-card-gateway.php:223
msgid "Could not create the PayKKa payment session. Please try again later."
msgstr "PayKKa 支付会话创建失败，请稍后重试。"

#: classes/wc-paykka-card-gateway.php:245
#: classes/wc-paykka-credit-card-gateway.php:370
#: classes/wc-paykka-credit-card-gateway.php:441
msgid "Invalid order"
msgstr "订单无效"

#: classes/wc-paykka-card-gateway.php:254
msgid "Please enter complete card details and finish the payment before placing the order."
msgstr "请填写完整的银行卡信息并完成支付后再下单。"

#: classes/wc-paykka-card-gateway.php:271
msgid "Paykka gateway unavailable"
msgstr "Paykka 网关不可用"

#: classes/wc-paykka-card-gateway.php:316
msgid "Please enter a valid billing email address."
msgstr "请填写有效的账单邮箱。"

#: classes/wc-paykka-card-gateway.php:319
msgid "Please select a billing country/region."
msgstr "请选择账单国家/地区。"

#: classes/wc-paykka-card-gateway.php:324
msgid "The billing postcode / ZIP is invalid. Please correct it for the selected country/region before paying."
msgstr "账单邮编 / ZIP 格式不正确，请按国家/地区要求修改后再支付。"

#: classes/wc-paykka-card-gateway.php:330
msgid "The billing phone number is invalid."
msgstr "账单电话号码格式不正确。"

#: classes/wc-paykka-credit-card-gateway.php:33
msgid "Shows “Paykka Hosted” at checkout. Customers are redirected to the Paykka Hosted checkout to complete the payment."
msgstr "结账页显示「Paykka Hosted」，顾客选择后跳转 Paykka Hosted 收银台完成支付。"

#: classes/wc-paykka-credit-card-gateway.php:34
#: classes/wc-paykka-credit-card-gateway.php:36
