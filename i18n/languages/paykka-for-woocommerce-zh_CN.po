msgstr "退款金额无效"

#: classes/wc-paykka-credit-card-gateway.php:453
msgid "Payment query failed"
msgstr "交易查询失败"

#: classes/wc-paykka-credit-card-gateway.php:462
msgid "No PayKKa gateway transaction has been found for this order yet, so it cannot be refunded."
msgstr "尚未查询到该订单的 PayKKa 网关交易，无法退款。"

#: classes/wc-paykka-credit-card-gateway.php:468
#, php-format
msgid "Order status %s is not refundable"
msgstr "订单状态 %s 不支持退款"

#: classes/wc-paykka-credit-card-gateway.php:481
msgid "Refund amount exceeds available refundable amount"
msgstr "退款金额超出可退金额"

#: classes/wc-paykka-credit-card-gateway.php:490
msgid "Refund request failed"
msgstr "退款请求失败"

#: woocommerce-paykka-gateway.php:97 woocommerce-paykka-gateway.php:112
msgid "WooCommerce unavailable"
msgstr "WooCommerce 不可用"

#: woocommerce-paykka-gateway.php:101
msgid "Credit Card gateway unavailable"
msgstr "银行卡网关不可用"

#: woocommerce-paykka-gateway.php:116
msgid "Payments gateway unavailable"
msgstr "Payments 网关不可用"

#: includes/blocks/wc-gateway-paykka-card-support.php:96
msgid "Preparing the secure payment form…"
msgstr "正在准备安全支付表单…"

#: includes/blocks/wc-gateway-paykka-card-support.php:97
msgid "Ready"
msgstr "已就绪"

#: includes/blocks/wc-gateway-paykka-card-support.php:98
msgid "The PayKKa payment form failed to load. Please refresh and try again."
msgstr "PayKKa 支付表单加载失败，请刷新后重试。"

#: includes/blocks/wc-gateway-paykka-card-support.php:99
msgid "Please enter your billing email and country/region first."
msgstr "请先填写账单邮箱和国家/地区。"

#: includes/blocks/wc-gateway-paykka-card-support.php:100
msgid "The payment form is not ready yet. Please wait a moment before placing your order."
msgstr "支付表单尚未就绪，请稍候再下单。"

#: includes/blocks/wc-gateway-paykka-card-support.php:101
msgid "Processing payment…"
msgstr "正在处理支付…"

#: includes/blocks/wc-gateway-paykka-card-support.php:102
msgid "Please enter your complete card details before placing the order, or use Apple Pay / Google Pay."
msgstr "请填写完整的银行卡信息后再下单，或使用 Apple Pay / Google Pay。"

#: includes/blocks/wc-gateway-paykka-card-support.php:103
msgid "Please fix the billing and address errors on the checkout page before paying."
msgstr "请先修正结账页账单/地址等错误后再支付。"
