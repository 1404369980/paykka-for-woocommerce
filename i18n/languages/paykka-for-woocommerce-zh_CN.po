msgstr "允许已登录顾客勾选保存支付信息（需账户侧支持）"

#: classes/wc-paykka-card-gateway.php:87
msgid "Please use the Blocks checkout page to pay with Payments."
msgstr "请使用 Blocks 结账页完成 Payments 支付。"

#: classes/wc-paykka-card-gateway.php:98 classes/wc-paykka-card-gateway.php:130
msgid "Security check failed. Please refresh the checkout page and try again."
msgstr "安全校验失败，请刷新结账页后重试。"

