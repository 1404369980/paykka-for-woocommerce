msgstr "PayKKa Order ID"

#: classes/utils/class-paykka-utils.php:303
#, php-format
msgid "PayKKa place order (%s)"
msgstr "PayKKa 发起支付（%s）"

#: classes/lib/Paykka/Request/PaykkaRequestHandler.php:380
msgid "Payment signature error"
msgstr "支付签名错误"

#: classes/lib/Paykka/Request/PaykkaRequestHandler.php:951
msgid "PayKKa: The local WooCommerce refund record was automatically removed."
msgstr "PayKKa：已自动移除本地 WooCommerce 退款记录。"

#: classes/lib/Paykka/Request/PaykkaCallBackHandler.php:80
msgid "The payment was not successful. Please try again or choose another payment method."
msgstr "支付未成功，请重试或更换支付方式。"

#: classes/lib/Paykka/Request/PaykkaCallBackHandler.php:82
msgid "We have not received your payment yet. Please start the payment again."
msgstr "尚未收到您的付款，请重新发起支付。"

#: classes/lib/Paykka/Request/PaykkaCallBackHandler.php:84
msgid "Your payment is still being confirmed. Please refresh in a moment or contact support."
msgstr "支付结果确认中，请稍候刷新或联系客服。"

#: classes/lib/Paykka/Request/PaykkaCallBackHandler.php:102
msgid "We cannot confirm the payment result right now. Please try again later or contact support."
msgstr "暂时无法确认支付结果，请稍后再试或联系客服。"

#: classes/wc-paykka-card-gateway.php:20
msgid "Paykka Payments"
msgstr "Paykka Payments"

#: classes/wc-paykka-card-gateway.php:21
msgid "Embedded Payments (card / Apple Pay / Google Pay) inside the WooCommerce Blocks checkout. Selecting it shows the payment components, and customers pay by placing the order or using a wallet button. Paykka Hosted is unaffected."
msgstr "WooCommerce Blocks 结账页内嵌 Payments（银行卡 / Apple Pay / Google Pay）。选中后展示支付组件，点击下单或钱包按钮完成支付。不影响 Paykka Hosted。"

